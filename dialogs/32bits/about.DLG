IDD_ABOUT DIALOG DISCARDABLE  20, 40, 172, 147
STYLE DS_MODALFRAME | WS_OVERLAPPED | WS_CAPTION | WS_VISIBLE | WS_SYSMENU
CAPTION "ABOUT_DIALOG"
FONT 8, "Helv"
BEGIN
	CONTROL "", IDC_FRAME_ABOUT, "STATIC", SS_RIGHT | SS_SUNKEN | WS_CHILD | WS_VISIBLE, 5, 4, 161, 95
	CONTROL "", IDC_PICTURE_ABOUT, "STATIC", SS_BITMAP | WS_CHILD | WS_VISIBLE, 8, 8, 153, 87
	CONTROL "Push", IDC_BUTTON_ABOUT, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 49, 120, 74, 15
	CONTROL "", IDC_TEXT_ABOUT, "STATIC", SS_CENTER | SS_NOPREFIX | WS_CHILD | WS_VISIBLE, 7, 110, 159, 14
END
